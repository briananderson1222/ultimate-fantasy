{
  "openapi": "3.0.0",
  "info": {
    "title": "Shared Hook Contract",
    "version": "1.0.0",
    "description": "Contract specification for shared React hooks"
  },
  "components": {
    "schemas": {
      "SharedHook": {
        "type": "object",
        "required": ["name", "returnType", "platform"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^use[A-Z][a-zA-Z0-9]*$",
            "description": "Hook name starting with 'use'"
          },
          "parameters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HookParam"
            }
          },
          "returnType": {
            "type": "string",
            "description": "TypeScript return type"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Other hooks or services used"
          },
          "platform": {
            "type": "string",
            "enum": ["universal"],
            "description": "Platform compatibility"
          }
        }
      },
      "HookParam": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z_$][a-zA-Z0-9_$]*$",
            "description": "Parameter name"
          },
          "type": {
            "type": "string",
            "description": "TypeScript type"
          },
          "optional": {
            "type": "boolean",
            "default": false,
            "description": "Is optional parameter"
          },
          "description": {
            "type": "string",
            "description": "Parameter description"
          }
        }
      }
    }
  }
}