{
  "name": "ultimate-fantasy-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "echo \"No frontend unit tests yet\" && exit 0",
    "test:e2e": "playwright test",
    "e2e:headed": "playwright test --headed --project=chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.87.4",
    "next": "15.5.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwindcss": "4.1.13"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.10.4",
    "@playwright/test": "1.48.2",
    "@types/node": "24.3.2",
    "@types/react": "19.1.13",
    "autoprefixer": "10.4.21",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.3",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  }
}
