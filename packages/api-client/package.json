{
  "name": "@ultimate-fantasy/api-client",
  "version": "1.0.0",
  "type": "module",
  "description": "Platform-agnostic HTTP client and API services for Ultimate Fantasy platform",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "clean": "rm -rf dist",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "keywords": [
    "api-client",
    "http-client",
    "cross-platform",
    "fantasy-sports",
    "rest-api"
  ],
  "author": "Ultimate Fantasy Team",
  "license": "MIT",
  "dependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "react-query": "^3.39.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "jest": "^29.6.0",
    "prettier": "^3.0.0",
    "rollup": "^3.26.0",
    "typescript": "^5.1.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./services": {
      "import": "./src/services/index.ts",
      "require": "./src/services/index.ts",
      "types": "./src/services/index.ts"
    }
  }
}
