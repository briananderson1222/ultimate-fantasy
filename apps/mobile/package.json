{
  "name": "@ultimate-fantasy/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export",
    "test": "jest",
    "test:visual": "detox test",
    "test:visual:ios": "detox test --configuration ios.sim.debug",
    "test:visual:android": "detox test --configuration android.emu.debug",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist .expo"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/stack": "^7.1.0",
    "@tanstack/react-query": "5.89.0",
    "@ultimate-fantasy/api-client": "1.0.0",
    "@ultimate-fantasy/shared-logic": "1.0.0",
    "@ultimate-fantasy/ui-components": "1.0.0",
    "expo": "~54.0.9",
    "expo-haptics": "^15.0.7",
    "expo-local-authentication": "^17.0.7",
    "expo-secure-store": "^15.0.7",
    "expo-sqlite": "~15.0.3",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.1",
    "react-native": "0.81.4",
    "react-native-background-job": "^2.3.1",
    "react-native-gesture-handler": "2.28.0",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "4.16.0",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-web": "^0.21.0",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "19.1.13",
    "detox": "^20.41.3",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jest": "30.1.3",
    "jest-expo": "^54.0.12",
    "react-test-renderer": "^19.1.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
