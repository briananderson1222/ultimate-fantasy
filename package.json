{
  "name": "ultimate-fantasy",
  "version": "1.0.0",
  "private": true,
  "description": "Ultimate Fantasy Sports Platform - Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:landing": "npm run dev --workspace=apps/landing",
    "build:web": "npm run build --workspace=apps/web",
    "build:mobile": "npm run build --workspace=apps/mobile",
    "build:api": "npm run build --workspace=apps/api",
    "build:landing": "npm run build --workspace=apps/landing",
    "build:packages": "npm run build --workspace=packages/shared-logic && npm run build --workspace=packages/ui-components && npm run build --workspace=packages/api-client",
    "test:web": "npm run test --workspace=apps/web",
    "test:mobile": "npm run test --workspace=apps/mobile",
    "test:api": "npm run test --workspace=apps/api",
    "test:packages": "npm run test --workspace=packages/shared-logic && npm run test --workspace=packages/ui-components && npm run test --workspace=packages/api-client",
    "clean": "npm run clean --workspaces",
    "install:all": "npm install"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0",
    "typescript": "^5.1.0"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "author": "Ultimate Fantasy Team",
  "license": "MIT"
}